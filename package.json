{
  "name": "klose",
  "version": "0.2.0",
  "description": "A local, no-login design canvas that installs as a /klose skill in Claude Code \u2014 sketch components against your repo's real design system, point at the exact element that is wrong, and have the agent build it into your source tree.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "claude-code",
    "claude",
    "design",
    "design-system",
    "canvas",
    "ui",
    "tailwind",
    "skill",
    "local-first",
    "ai-agent",
    "design-tool",
    "component-library",
    "react",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityakarki99/OpenKlose.git"
  },
  "homepage": "https://github.com/adityakarki99/OpenKlose#readme",
  "bugs": {
    "url": "https://github.com/adityakarki99/OpenKlose/issues"
  },
  "bin": {
    "klose": "bin/klose.js"
  },
  "files": [
    "bin",
    "server",
    "skills",
    "web/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke-pack.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@babel/standalone": "^7.28.4",
    "@tailwindcss/browser": "^4.1.13",
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^22.19.15",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.2.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
